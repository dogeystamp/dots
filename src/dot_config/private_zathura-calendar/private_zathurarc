set statusbar-home-tilde true

set adjust-open height
set single-page-mode true

set font "IBM Plex Mono 12"

set recolor-darkcolor "#dddddd"
set recolor-lightcolor rgba(0,0,0,1.0)
set recolor false
set recolor-keephue true
set recolor-reverse-video true

set default-bg "#00000000"
set inputbar-bg rgba(0,0,0,1.0)
set inputbar-fg "#CCCCCC"
set statusbar-bg rgba(0,0,0,1)
set statusbar-fg "#CCCCCC"

# disable statusbar
# press ctrl-n to toggle status bar at runtime
set guioptions ""

set render-loading false

set selection-clipboard clipboard

set database sqlite
